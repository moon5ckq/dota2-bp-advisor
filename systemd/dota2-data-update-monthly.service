[Unit]
Description=Dota2 BP Advisor - Monthly Lane Roles Data Update

[Service]
Type=oneshot
WorkingDirectory=/root/.openclaw/workspace/dota2-bp-advisor/backend
ExecStart=/usr/bin/python3 scripts/update_data.py --lane-roles
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dota2-data-update
